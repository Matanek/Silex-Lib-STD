use Interop.C
use Interop.Boundary

let getrandom = C.function<
    func(C.MutablePointer<uint32>, C.Size, uint32) C.SignedSize
>(
    library:Boundary.System,
    name:"getrandom"
)

func system_seed() int {
    var seed:uint32 = 0
    let written = getrandom(C.mutable_pointer(seed), 4 as C.Size, 0)
    if written != 4 as C.SignedSize {
        panic("Linux getrandom could not produce a complete seed")
    }
    return seed as int
}
