use STD.File
use STD.FileSystem
use STD.Error

test "filesystem operations" {
    func has_entry(entries:FileSystem.Entry[], name:str) bool {
        for entry in entries { if entry.name == name { return true } }
        return false
    }

    func is_file(kind:FileSystem.Kind) bool {
        return match kind { file => true; else => false }
    }

    func run() Result<void, Error> {
        let root = "/private/tmp/silex-std-filesystem-test"
        let nested = root + "/a/b"
        let source = nested + "/source.txt"
        let copied = nested + "/copied.txt"
        let renamed = nested + "/renamed.txt"
        let empty = root + "/empty"
        let ignored_copy = (try FileSystem.remove_file(copied))
        let ignored_renamed = (try FileSystem.remove_file(renamed))
        try FileSystem.create_directories(nested) else error { return Result<void,Error>.failure(error) }
        try FileSystem.create_directory(empty) else error { return Result<void,Error>.failure(error) }
        try File.write_all(source, "filesystem") else error { return Result<void,Error>.failure(error) }

        let information = try FileSystem.metadata(source) else error { return Result<void,Error>.failure(error) }
        let direct_information = try FileSystem.symbolic_link_metadata(source) else error { return Result<void,Error>.failure(error) }
        assert(is_file(information.kind), "file kind")
        assert(is_file(direct_information.kind), "direct file kind")
        assert(information.size == 10, "file size")

        try FileSystem.copy_file(source, copied, true) else error { return Result<void,Error>.failure(error) }
        try FileSystem.rename(copied, renamed) else error { return Result<void,Error>.failure(error) }
        let entries = try FileSystem.list(nested) else error { return Result<void,Error>.failure(error) }
        assert(has_entry(entries, "source.txt"), "source listing")
        assert(has_entry(entries, "renamed.txt"), "renamed listing")

        try FileSystem.set_readonly(source, true) else error { return Result<void,Error>.failure(error) }
        assert((try FileSystem.metadata(source) else error { return Result<void,Error>.failure(error) }).readonly, "readonly metadata")
        try FileSystem.set_readonly(source, false) else error { return Result<void,Error>.failure(error) }
        let canonical = try FileSystem.canonicalize(source) else error { return Result<void,Error>.failure(error) }
        assert(canonical.count() > 0, "canonical path")

        try FileSystem.remove_file(source) else error { return Result<void,Error>.failure(error) }
        try FileSystem.remove_file(renamed) else error { return Result<void,Error>.failure(error) }
        try FileSystem.remove_directory(empty) else error { return Result<void,Error>.failure(error) }
        try FileSystem.remove_directory(nested) else error { return Result<void,Error>.failure(error) }
        try FileSystem.remove_directory(root + "/a") else error { return Result<void,Error>.failure(error) }
        try FileSystem.remove_directory(root) else error { return Result<void,Error>.failure(error) }
        return Result<void, Error>.success()
    }

    match (try run()) {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}
