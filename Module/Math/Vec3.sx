use STD.Math

public struct Vec3 {

    var x:float
    var y:float
    var z:float

    init() {}

    init(value:float) {
        self.x = value
        self.y = value
        self.z = value
    }

    init(x:float, y:float, z:float) {
        self.x = x
        self.y = y
        self.z = z
    }

    func add(other:Vec3) Vec3 {
        return Vec3(self.x + other.x, self.y + other.y, self.z + other.z)
    }

    func subtract(other:Vec3) Vec3 {
        return Vec3(self.x - other.x, self.y - other.y, self.z - other.z)
    }

    func multiply(value:Vec3) Vec3 {
        return Vec3(self.x * value.x, self.y * value.y, self.z * value.z)
    }

    func multiply(value:float) Vec3 {
        return Vec3(self.x * value, self.y * value, self.z * value)
    }

    func divide(value:Vec3) Vec3 {
        return Vec3(self.x / value.x, self.y / value.y, self.z / value.z)
    }

    func divide(value:float) Vec3 {
        return Vec3(self.x / value, self.y / value, self.z / value)
    }

    func negated() Vec3 {
        return Vec3(-self.x, -self.y, -self.z)
    }

    func dot(other:Vec3) float {
        return self.x * other.x + self.y * other.y + self.z * other.z
    }

    func cross(other:Vec3) Vec3 {
        return Vec3(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x
        )
    }

    func length_squared() float {
        return self.dot(self)
    }

    func length() float {
        return Math.sqrt(self.length_squared())
    }

    func distance(other:Vec3) float {
        return self.subtract(other).length()
    }

    func normalized() Vec3 {
        let scale = Math.max(Math.max(Math.abs(self.x), Math.abs(self.y)), Math.abs(self.z))
        if scale == 0.0 && !Math.is_nan(self.x) && !Math.is_nan(self.y) && !Math.is_nan(self.z) {
            return Vec3.zero()
        }
        let scaled = self.divide(scale)
        return scaled.divide(Math.sqrt(scaled.length_squared()))
    }

    func lerp(other:Vec3, amount:float) Vec3 {
        return Vec3(
            Math.lerp(self.x, other.x, amount),
            Math.lerp(self.y, other.y, amount),
            Math.lerp(self.z, other.z, amount)
        )
    }

    func mix(other:Vec3, amount:float) Vec3 {
        return self.lerp(other, amount)
    }

    func minimum(other:Vec3) Vec3 {
        return Vec3(
            Math.min(self.x, other.x),
            Math.min(self.y, other.y),
            Math.min(self.z, other.z)
        )
    }

    func maximum(other:Vec3) Vec3 {
        return Vec3(
            Math.max(self.x, other.x),
            Math.max(self.y, other.y),
            Math.max(self.z, other.z)
        )
    }

    func clamped(minimum:Vec3, maximum:Vec3) Vec3 {
        return Vec3(
            Math.clamp(self.x, minimum.x, maximum.x),
            Math.clamp(self.y, minimum.y, maximum.y),
            Math.clamp(self.z, minimum.z, maximum.z)
        )
    }

    func floor() Vec3 {
        return Vec3(Math.floor(self.x), Math.floor(self.y), Math.floor(self.z))
    }

    func ceil() Vec3 {
        return Vec3(Math.ceil(self.x), Math.ceil(self.y), Math.ceil(self.z))
    }

    func round() Vec3 {
        return Vec3(Math.round(self.x), Math.round(self.y), Math.round(self.z))
    }

    func trunc() Vec3 {
        return Vec3(Math.trunc(self.x), Math.trunc(self.y), Math.trunc(self.z))
    }

    func nearly_equal(other:Vec3) bool {
        return Math.nearly_equal(self.x, other.x) && Math.nearly_equal(self.y, other.y) &&
            Math.nearly_equal(self.z, other.z)
    }

    func nearly_equal(other:Vec3, tolerance:float) bool {
        return Math.nearly_equal(
            self.x,
            other.x,
            tolerance
        ) && Math.nearly_equal(
            self.y,
            other.y,
            tolerance
        ) && Math.nearly_equal(self.z, other.z, tolerance)
    }

    func to_str() str {
        return "{ $(self.x) $(self.y) $(self.z) }"
    }
}

extend Vec3 {
    static func zero() Vec3 { return Vec3() }
    static func one() Vec3 { return Vec3(1.0) }
    static func left() Vec3 { return Vec3(-1.0, 0.0, 0.0) }
    static func right() Vec3 { return Vec3(1.0, 0.0, 0.0) }
    static func up() Vec3 { return Vec3(0.0, 1.0, 0.0) }
    static func down() Vec3 { return Vec3(0.0, -1.0, 0.0) }
    static func front() Vec3 { return Vec3(0.0, 0.0, -1.0) }
    static func back() Vec3 { return Vec3(0.0, 0.0, 1.0) }
}
