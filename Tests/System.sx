use STD.System

test "selected platform and target" {
    func architecture_name(value:System.Architecture) str {
        return match value {
            arm64 => "arm64"
            x64 => "x64"
        }
    }

    let current_platform:System.OperatingSystem = System.platform()
    let current_target:System.CompilationTarget = System.target()
    assert(System.platform_name(current_target.platform) == System.platform_name(current_platform), "target platform differs from selected platform")
    let selected_architecture = architecture_name(current_target.architecture)

    match current_platform {
        macos => {
            assert(selected_architecture == "arm64" || selected_architecture == "x64", "macOS target architecture is unknown")
        }
        linux => {
            assert(selected_architecture == "arm64" || selected_architecture == "x64", "Linux target architecture is unknown")
        }
        windows => {
            assert(selected_architecture == "x64" || selected_architecture == "arm64", "Windows target architecture is unknown")
        }
    }

    let name = System.target_name(current_target)
    assert(name == System.platform_name(current_platform) + "-" + architecture_name(current_target.architecture), "target name is inconsistent")
    assert(
        name == "macos-arm64" || name == "macos-x64" ||
        name == "linux-arm64" || name == "linux-x64" ||
        name == "windows-arm64" || name == "windows-x64",
        "target name is outside the supported desktop matrix"
    )
}
