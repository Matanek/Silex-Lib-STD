use Interop.C
use STD.Text.Data
use STD.Text.UTF8

public enum Normalization { nfc; nfd; nfkc; nfkd }

public func normalize(text:str, form:Normalization) str {
    let input = UTF8.read_scalars(text)
    var decomposed:uint32[] = []
    let compatible = match form { nfc => false; nfd => false; nfkc => true; nfkd => true }
    for scalar in input { append_decomposed(decomposed, scalar, compatible) }
    let composed = match form { nfc => true; nfd => false; nfkc => true; nfkd => false }
    if composed { return encoded(compose(decomposed)) }
    return encoded(decomposed)
}
public func is_normalized(text:str, form:Normalization) bool { return text == normalize(text, form) }
public func lowercase(text:str) str { return map_case(text, 1) }
public func uppercase(text:str) str { return map_case(text, 2) }
public func case_fold(text:str) str { return map_case(text, 3) }
public func unicode_version() str { return "17.0.0" }

package func fold_scalar(scalar:uint32) uint32 {
    if mapped = case_mapping(Data.fold_keys(), Data.fold_metadata(), Data.fold_values(), scalar) {
        if mapped.count() == 1 { return mapped[0] }
    }
    return scalar
}

package func upper_scalar(scalar:uint32) uint32 {
    if mapped = case_mapping(Data.uppercase_keys(), Data.uppercase_metadata(), Data.uppercase_values(), scalar) {
        if mapped.count() == 1 { return mapped[0] }
    }
    return scalar
}

public func is_empty(text:@str) bool { return text == "" }

public func index_of(text:@str, expected:@str) int? {
    let values = UTF8.read_scalars(text)
    let searched = UTF8.read_scalars(expected)
    if searched.is_empty() { return 0 }
    if searched.count() > values.count() { return null }
    var index = 0
    while index <= values.count() - searched.count() {
        if matches_at(values, searched, index) { return index }
        index++
    }
    return null
}

public func contains(text:@str, expected:@str) bool {
    return index_of(text, expected) != null
}

public func starts_with(text:@str, prefix:@str) bool {
    let values = UTF8.read_scalars(text)
    let expected = UTF8.read_scalars(prefix)
    if expected.count() > values.count() { return false }
    return matches_at(values, expected, 0)
}

public func ends_with(text:@str, suffix:@str) bool {
    let values = UTF8.read_scalars(text)
    let expected = UTF8.read_scalars(suffix)
    if expected.count() > values.count() { return false }
    return matches_at(values, expected, values.count() - expected.count())
}

public func trim(text:@str) str {
    let values = UTF8.read_scalars(text)
    var first = 0
    while first < values.count() && is_whitespace(values[first]) { first++ }
    var last = values.count()
    while last > first && is_whitespace(values[last - 1]) { last-- }
    return encoded(values[first:last])
}

public func trim_start(text:@str) str {
    let values = UTF8.read_scalars(text)
    var first = 0
    while first < values.count() && is_whitespace(values[first]) { first++ }
    return encoded(values[first:values.count()])
}

public func trim_end(text:@str) str {
    let values = UTF8.read_scalars(text)
    var last = values.count()
    while last > 0 && is_whitespace(values[last - 1]) { last-- }
    return encoded(values[0:last])
}

public func replace(text:@str, expected:@str, replacement:@str) str {
    let values = UTF8.read_scalars(text)
    let searched = UTF8.read_scalars(expected)
    if searched.is_empty() { return "" + text }
    let inserted = UTF8.read_scalars(replacement)
    var result:uint32[] = []
    var index = 0
    while index < values.count() {
        if index <= values.count() - searched.count() && matches_at(values, searched, index) {
            for scalar in inserted { result.append(scalar) }
            index += searched.count()
        } else {
            result.append(values[index])
            index++
        }
    }
    return encoded(result)
}

public func slice(text:@str, start:int, end:int) str {
    let values = UTF8.read_scalars(text)
    if start < 0 || end < start || end > values.count() { panic("text slice is outside its Unicode scalar bounds") }
    return encoded(values[start:end])
}

public func split(text:@str, separator:@str) str[] {
    let values = UTF8.read_scalars(text)
    let searched = UTF8.read_scalars(separator)
    if searched.is_empty() { return ["" + text] }
    var result:str[] = []
    var start = 0
    var index = 0
    while index <= values.count() - searched.count() {
        if matches_at(values, searched, index) {
            result.append(encoded(values[start:index]))
            index += searched.count()
            start = index
        } else { index++ }
    }
    result.append(encoded(values[start:values.count()]))
    return result
}

public func join(values:@str[], separator:@str) str {
    var result:uint32[] = []
    let inserted = UTF8.read_scalars(separator)
    var index = 0
    while index < values.count() {
        if index > 0 { for scalar in inserted { result.append(scalar) } }
        for scalar in UTF8.read_scalars(values[index]) { result.append(scalar) }
        index++
    }
    return encoded(result)
}

public func titlecase(text:@str) str {
    let input = UTF8.read_scalars(text)
    var output:uint32[] = []
    var inside_word = false
    var index = 0
    while index < input.count() {
        let scalar = input[index]
        if in_plain_ranges(Data.cased_ranges(), scalar) {
            if inside_word && scalar == 0x03A3 && final_sigma(input, index) { output.append(0x03C2 as uint32) }
            else {
                var kind = 4
                if inside_word { kind = 1 }
                append_case(output, scalar, kind)
            }
            inside_word = true
        } else {
            output.append(scalar)
            if !in_plain_ranges(Data.case_ignorable_ranges(), scalar) { inside_word = false }
        }
        index++
    }
    return encoded(output)
}

func matches_at(values:@uint32[], expected:@uint32[], index:int) bool {
    if index < 0 || index + expected.count() > values.count() { return false }
    var offset = 0
    while offset < expected.count() {
        if values[index + offset] != expected[offset] { return false }
        offset++
    }
    return true
}

func append_case(output:&uint32[], scalar:uint32, kind:int) {
    if kind == 4 {
        let title = titlecase_scalar(scalar)
        if title != 0 { output.append(title); return }
    }
    var keys = Data.lowercase_keys()
    var metadata = Data.lowercase_metadata()
    var values = Data.lowercase_values()
    if kind == 2 || kind == 4 {
        keys = Data.uppercase_keys()
        metadata = Data.uppercase_metadata()
        values = Data.uppercase_values()
    }
    if kind == 3 {
        keys = Data.fold_keys()
        metadata = Data.fold_metadata()
        values = Data.fold_values()
    }
    if mapped = case_mapping(keys, metadata, values, scalar) { for value in mapped { output.append(value) } }
    else { output.append(scalar) }
}

func titlecase_scalar(scalar:uint32) uint32 {
    if scalar >= 0x01C4 && scalar <= 0x01C6 { return 0x01C5 }
    if scalar >= 0x01C7 && scalar <= 0x01C9 { return 0x01C8 }
    if scalar >= 0x01CA && scalar <= 0x01CC { return 0x01CB }
    if scalar >= 0x01F1 && scalar <= 0x01F3 { return 0x01F2 }
    return 0
}

func is_whitespace(scalar:uint32) bool {
    if scalar >= 0x09 && scalar <= 0x0D { return true }
    if scalar == 0x20 || scalar == 0x85 || scalar == 0xA0 || scalar == 0x1680 { return true }
    if scalar >= 0x2000 && scalar <= 0x200A { return true }
    return scalar == 0x2028 || scalar == 0x2029 || scalar == 0x202F || scalar == 0x205F || scalar == 0x3000
}

func append_decomposed(output:&uint32[], scalar:uint32, compatible:bool) {
    if scalar >= 0xAC00 && scalar <= 0xD7A3 {
        let offset = scalar - 0xAC00
        let leading:uint32 = 0x1100 + offset / 588
        let vowel:uint32 = 0x1161 + (offset % 588) / 28
        let trailing = offset % 28
        append_ordered(output, leading)
        append_ordered(output, vowel)
        if trailing != 0 { append_ordered(output, (0x11A7 as uint32) + trailing) }
        return
    }
    if values = decomposition(scalar, compatible) {
        for value in values { append_decomposed(output, value, compatible) }
        return
    }
    append_ordered(output, scalar)
}

func append_ordered(output:&uint32[], scalar:uint32) {
    output.append(scalar)
    let current = combining_class(scalar)
    if current == 0 { return }
    var index = output.count() - 1
    while index > 0 {
        let previous = combining_class(output[index - 1])
        if previous == 0 || previous <= current { return }
        let temporary = output[index - 1]
        output[index - 1] = output[index]
        output[index] = temporary
        index--
    }
}

func compose(values:uint32[]) uint32[] {
    if values.count() == 0 { return [] }
    var result:uint32[] = [values[0]]
    var starter_index = 0
    var starter = values[0]
    var previous_class:uint32 = 0
    var index = 1
    while index < values.count() {
        let scalar = values[index]
        let current_class = combining_class(scalar)
        let candidate = composite(starter, scalar)
        if candidate != 0 && (previous_class < current_class || previous_class == 0) {
            result[starter_index] = candidate
            starter = candidate
        } else {
            if current_class == 0 {
                starter_index = result.count()
                starter = scalar
            }
            result.append(scalar)
            previous_class = current_class
        }
        index++
    }
    return result
}

func composite(first:uint32, second:uint32) uint32 {
    if first >= 0x1100 && first <= 0x1112 && second >= 0x1161 && second <= 0x1175 {
        return (0xAC00 as uint32) + ((first - 0x1100) * 21 + (second - 0x1161)) * 28
    }
    if first >= 0xAC00 && first <= 0xD7A3 && (first - 0xAC00) % 28 == 0 && second >= 0x11A8 && second <= 0x11C2 {
        return first + second - 0x11A7
    }
    let keys = Data.composition_keys()
    let record = find_pair(keys, first, second)
    if record < 0 { return 0 }
    return read_u21(Data.composition_values(), record * 4)
}

func decomposition(scalar:uint32, compatible:bool) uint32[]? {
    let record = find_key(Data.decomposition_keys(), scalar)
    if record < 0 { return null }
    let metadata = Data.decomposition_metadata()
    if read_digit(metadata, record * 6 + 5) != 0 && !compatible { return null }
    let offset = read_u21(metadata, record * 6) as int
    let count = read_digit(metadata, record * 6 + 4) as int
    return read_values(Data.decomposition_values(), offset, count)
}

func combining_class(scalar:uint32) uint32 {
    let record = find_key(Data.combining_keys(), scalar)
    if record < 0 { return 0 }
    return read_u21(Data.combining_values(), record * 4)
}

func map_case(text:str, kind:int) str {
    let input = UTF8.read_scalars(text)
    var output:uint32[] = []
    var index = 0
    while index < input.count() {
        let scalar = input[index]
        if kind == 1 && scalar == 0x03A3 && final_sigma(input, index) {
            output.append(0x03C2 as uint32)
        } else {
            var keys = Data.lowercase_keys()
            var metadata = Data.lowercase_metadata()
            var values = Data.lowercase_values()
            if kind == 2 {
                keys = Data.uppercase_keys()
                metadata = Data.uppercase_metadata()
                values = Data.uppercase_values()
            } elif kind == 3 {
                keys = Data.fold_keys()
                metadata = Data.fold_metadata()
                values = Data.fold_values()
            }
            if mapped = case_mapping(keys, metadata, values, scalar) { for value in mapped { output.append(value) } }
            else { output.append(scalar) }
        }
        index++
    }
    return encoded(output)
}

func case_mapping(keys:str, metadata:str, values:str, scalar:uint32) uint32[]? {
    let record = find_key(keys, scalar)
    if record < 0 { return null }
    let offset = read_u21(metadata, record * 5) as int
    let count = read_digit(metadata, record * 5 + 4) as int
    return read_values(values, offset, count)
}

func final_sigma(values:uint32[], index:int) bool {
    var before = index
    var preceded = false
    while before > 0 {
        before--
        let scalar = values[before]
        if in_plain_ranges(Data.case_ignorable_ranges(), scalar) { continue }
        preceded = in_plain_ranges(Data.cased_ranges(), scalar)
        break
    }
    if !preceded { return false }
    var after = index + 1
    while after < values.count() {
        let scalar = values[after]
        if in_plain_ranges(Data.case_ignorable_ranges(), scalar) {
            after++
            continue
        }
        return !in_plain_ranges(Data.cased_ranges(), scalar)
    }
    return true
}

func encoded(values:uint32[]) str {
    let view = @values[0:values.count()]
    match UTF8.from_scalars(view) {
        success(text) => { return text }
        failure(error) => { panic("Unicode table produced an invalid scalar") }
    }
}

func read_values(data:str, offset:int, count:int) uint32[] {
    var result:uint32[] = []
    var index = 0
    while index < count {
        result.append(read_u21(data, (offset + index) * 4))
        index++
    }
    return result
}

func find_key(data:str, scalar:uint32) int {
    var first = 0
    var last = (C.byte_count(data) / 4) as int
    while first < last {
        let middle = first + (last - first) / 2
        if read_u21(data, middle * 4) < scalar { first = middle + 1 } else { last = middle }
    }
    if first * 4 < C.byte_count(data) as int && read_u21(data, first * 4) == scalar { return first }
    return -1
}

func find_pair(data:str, first_scalar:uint32, second_scalar:uint32) int {
    var first = 0
    var last = (C.byte_count(data) / 8) as int
    while first < last {
        let middle = first + (last - first) / 2
        let left = read_u21(data, middle * 8)
        let right = read_u21(data, middle * 8 + 4)
        if left < first_scalar || (left == first_scalar && right < second_scalar) { first = middle + 1 } else { last = middle }
    }
    if first * 8 < C.byte_count(data) as int && read_u21(data, first * 8) == first_scalar && read_u21(data, first * 8 + 4) == second_scalar { return first }
    return -1
}

func in_plain_ranges(data:str, scalar:uint32) bool {
    var first = 0
    var last = (C.byte_count(data) / 8) as int
    while first < last {
        let middle = first + (last - first) / 2
        if read_u21(data, middle * 8 + 4) < scalar { first = middle + 1 } else { last = middle }
    }
    return first * 8 < C.byte_count(data) as int && read_u21(data, first * 8) <= scalar
}

func read_u21(data:str, offset:int) uint32 {
    return (read_digit(data, offset) << 18) + (read_digit(data, offset + 1) << 12) + (read_digit(data, offset + 2) << 6) + read_digit(data, offset + 3)
}

func read_digit(data:str, offset:int) uint32 {
    let byte = C.byte_at(data, offset as uint)
    if byte >= 65 && byte <= 90 { return (byte - 65) as uint32 }
    if byte >= 97 && byte <= 122 { return (byte - 97 + 26) as uint32 }
    if byte >= 48 && byte <= 57 { return (byte - 48 + 52) as uint32 }
    if byte == 43 { return 62 }
    return 63
}
