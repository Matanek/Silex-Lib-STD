{
  "name": "STD",
  "version": "0.17.0",
  "requires": {
    "silex": ">=0.38.37"
  },
  "boundary": {
    "macos-arm64": {
      "providers": {
        "System": {
          "libraries": ["System"]
        },
        "Security": {
          "frameworks": ["CoreFoundation", "Security"]
        },
        "Compression": {
          "archive": "Boundary/macos-arm64/libCompression.a"
        },
        "NetworkRuntime": {
          "archive": "Boundary/macos-arm64/libNetworkRuntime.a"
        }
      }
    },
    "linux-x64": {
      "providers": {
        "System": {
          "libraries": ["c", "m", "pthread"]
        },
        "Compression": {
          "archive": "Boundary/linux-x64/libCompression.a"
        },
        "NetworkRuntime": {
          "archive": "Boundary/linux-x64/libNetworkRuntime.a"
        }
      }
    },
    "windows-x64": {
      "providers": {
        "System": {
          "libraries": ["kernel32"]
        },
        "Runtime": {
          "libraries": ["ucrtbase"]
        },
        "Crypto": {
          "libraries": ["bcryptprimitives"]
        },
        "Network": {
          "libraries": ["ws2_32"]
        },
        "Compression": {
          "archive": "Boundary/windows-x64/Compression.lib"
        },
        "NetworkRuntime": {
          "archive": "Boundary/windows-x64/NetworkRuntime.lib"
        }
      }
    },
    "windows-arm64": {
      "providers": {
        "System": {
          "libraries": ["kernel32"]
        },
        "Runtime": {
          "libraries": ["ucrtbase"]
        },
        "Crypto": {
          "libraries": ["bcryptprimitives"]
        },
        "Network": {
          "libraries": ["ws2_32"]
        },
        "Compression": {
          "archive": "Boundary/windows-arm64/Compression.lib"
        },
        "NetworkRuntime": {
          "archive": "Boundary/windows-arm64/NetworkRuntime.lib"
        }
      }
    }
  }
}
