use STD.Regex.Types.Options
use STD.Regex.Syntax.SyntaxNode
use STD.Regex.Unicode.ScalarRange
use STD.Regex.Unicode.word_ranges

struct State {
    let kind:int
    var first:int
    var second:int
    let scalar:uint32
    let ranges:ScalarRange[]
    let negated:bool
    let capture_index:int
    var minimum:int
    var maximum:int
    var counter_index:int
    var greedy:bool

    init(
        kind:int,
        first:int,
        second:int,
        scalar:uint32,
        ranges:ScalarRange[],
        negated:bool,
        capture_index:int
    ) {
        self.kind = kind
        self.first = first
        self.second = second
        self.scalar = scalar
        self.ranges = ranges
        self.negated = negated
        self.capture_index = capture_index
        self.minimum = 0
        self.maximum = 0
        self.counter_index = 0
        self.greedy = true
    }
}

struct Patch {
    let state:int
    let edge:int
}

struct Fragment {
    let start:int
    let outs:Patch[]
}

struct Program {
    let states:State[]
    let start:int
    let capture_count:int
    let capture_names:str[]
    let options:Options
    let counter_count:int
    let prefix:uint32?
}

class Compiler {
    private var states:State[]
    private var counter_total:int

    init() { self.states = []; self.counter_total = 0 }

    func compile(
        syntax_nodes:SyntaxNode[],
        root:int,
        capture_names:str[],
        options:Options
    ) Program {
        let fragment = self.node(syntax_nodes, root)
        let accepted = self.emit(State(10, -1, -1, 0, [], false, 0))
        self.patch(fragment.outs, accepted)
        return Program(
            states:self.states,
            start:fragment.start,
            capture_count:capture_names.count() - 1,
            capture_names:capture_names,
            options:options,
            counter_count:self.counter_total,
            prefix:first_required_literal(syntax_nodes, root)
        )
    }

    private func node(syntax_nodes:SyntaxNode[], index:int) Fragment {
        let syntax = syntax_nodes[index]
        if syntax.kind == 1 { return self.empty() }
        if syntax.kind == 2 { return self.consuming(State(1, -1, -1, syntax.scalar, [], false, 0)) }
        if syntax.kind == 3 { return self.consuming(State(2, -1, -1, 0, [], false, 0)) }
        if syntax.kind == 6 {
            return self.consuming(State(3, -1, -1, 0, syntax.ranges, syntax.negated, 0))
        }
        if syntax.kind == 4 {
            return self.concatenate(
                self.node(syntax_nodes, syntax.children[0]),
                self.node(syntax_nodes, syntax.children[1])
            )
        }
        if syntax.kind == 5 {
            return self.alternate(
                self.node(syntax_nodes, syntax.children[0]),
                self.node(syntax_nodes, syntax.children[1])
            )
        }
        if syntax.kind == 7 { return self.zero_width(6) }
        if syntax.kind == 8 { return self.zero_width(7) }
        if syntax.kind == 9 {
            return self.capture(syntax.capture_index, self.node(syntax_nodes, syntax.children[0]))
        }
        if syntax.kind == 11 { return self.word_boundary(11) }
        if syntax.kind == 12 { return self.word_boundary(12) }
        if syntax.kind == 10 { return self.repeat(syntax_nodes, syntax) }
        panic("unknown regex syntax node")
    }

    private func empty() Fragment { return self.zero_width(5) }

    private func zero_width(kind:int) Fragment {
        let state = self.emit(State(kind, -1, -1, 0, [], false, 0))
        var outs:Patch[] = []
        outs.append(Patch(state:state, edge:1))
        return Fragment(start:state, outs:outs)
    }

    private func word_boundary(kind:int) Fragment {
        let state = self.emit(State(kind, -1, -1, 0, word_ranges(), false, 0))
        var outs:Patch[] = []
        outs.append(Patch(state:state, edge:1))
        return Fragment(start:state, outs:outs)
    }

    private func consuming(state:State) Fragment {
        let index = self.emit(state)
        var outs:Patch[] = []
        outs.append(Patch(state:index, edge:1))
        return Fragment(start:index, outs:outs)
    }

    private func concatenate(left:Fragment, right:Fragment) Fragment {
        self.patch(left.outs, right.start)
        return Fragment(start:left.start, outs:right.outs)
    }

    private func alternate(left:Fragment, right:Fragment) Fragment {
        let split = self.emit(State(4, left.start, right.start, 0, [], false, 0))
        return Fragment(start:split, outs:joined(left.outs, right.outs))
    }

    private func optional(child:Fragment, greedy:bool) Fragment {
        var first = child.start
        var second = -1
        var exit_edge = 2
        if !greedy { first = -1; second = child.start; exit_edge = 1 }
        let split = self.emit(State(4, first, second, 0, [], false, 0))
        var outs = child.outs
        outs.append(Patch(state:split, edge:exit_edge))
        return Fragment(start:split, outs:outs)
    }

    private func star(child:Fragment, greedy:bool) Fragment {
        var first = child.start
        var second = -1
        var exit_edge = 2
        if !greedy { first = -1; second = child.start; exit_edge = 1 }
        let split = self.emit(State(4, first, second, 0, [], false, 0))
        self.patch(child.outs, split)
        var outs:Patch[] = []
        outs.append(Patch(state:split, edge:exit_edge))
        return Fragment(start:split, outs:outs)
    }

    private func repeat(syntax_nodes:SyntaxNode[], syntax:SyntaxNode) Fragment {
        if syntax.maximum > 4 && fixed_syntax_width(syntax_nodes, syntax.children[0]) > 0 {
            return self.compact_repeat(
                self.node(syntax_nodes, syntax.children[0]),
                syntax.minimum,
                syntax.maximum,
                syntax.greedy
            )
        }
        var result = self.empty()
        var count = 0
        while count < syntax.minimum {
            result = self.concatenate(result, self.node(syntax_nodes, syntax.children[0]))
            count++
        }
        if syntax.maximum < 0 {
            result = self.concatenate(
                result,
                self.star(self.node(syntax_nodes, syntax.children[0]), syntax.greedy)
            )
        } else {
            while count < syntax.maximum {
                result = self.concatenate(
                    result,
                    self.optional(self.node(syntax_nodes, syntax.children[0]), syntax.greedy)
                )
                count++
            }
        }
        return result
    }

    private func compact_repeat(child:Fragment, minimum:int, maximum:int, greedy:bool) Fragment {
        let counter = self.counter_total
        self.counter_total++
        let gate = self.emit(State(14, child.start, -1, 0, [], false, 0))
        self.states[gate].minimum = minimum
        self.states[gate].maximum = maximum
        self.states[gate].counter_index = counter
        self.states[gate].greedy = greedy
        let increment = self.emit(State(15, gate, -1, 0, [], false, 0))
        self.states[increment].counter_index = counter
        self.patch(child.outs, increment)
        let reset = self.emit(State(13, gate, -1, 0, [], false, 0))
        self.states[reset].counter_index = counter
        var outs:Patch[] = []
        outs.append(Patch(state:gate, edge:2))
        return Fragment(start:reset, outs:outs)
    }

    private func capture(index:int, child:Fragment) Fragment {
        let opening = self.emit(State(8, child.start, -1, 0, [], false, index))
        let closing = self.emit(State(9, -1, -1, 0, [], false, index))
        self.patch(child.outs, closing)
        var outs:Patch[] = []
        outs.append(Patch(state:closing, edge:1))
        return Fragment(start:opening, outs:outs)
    }

    private func emit(state:State) int {
        let index = self.states.count()
        self.states.append(state)
        return index
    }

    private func patch(values:Patch[], target:int) {
        for value in values {
            if value.edge == 1 { self.states[value.state].first = target }
            else { self.states[value.state].second = target }
        }
    }
}

func fixed_syntax_width(nodes:@SyntaxNode[], index:int) int {
    let node = nodes[index]
    if node.kind == 1 || node.kind == 7 || node.kind == 8 || node.kind == 11 || node.kind == 12 { return 0 }
    if node.kind == 2 || node.kind == 3 || node.kind == 6 { return 1 }
    if node.kind == 4 {
        let left = fixed_syntax_width(nodes, node.children[0])
        let right = fixed_syntax_width(nodes, node.children[1])
        if left < 0 || right < 0 { return -1 }
        return left + right
    }
    if node.kind == 5 {
        let left = fixed_syntax_width(nodes, node.children[0])
        let right = fixed_syntax_width(nodes, node.children[1])
        if left == right { return left }
        return -1
    }
    if node.kind == 9 { return fixed_syntax_width(nodes, node.children[0]) }
    if node.kind == 10 {
        if node.maximum != node.minimum { return -1 }
        let child = fixed_syntax_width(nodes, node.children[0])
        if child < 0 { return -1 }
        return child * node.minimum
    }
    return -1
}

func first_required_literal(nodes:@SyntaxNode[], index:int) uint32? {
    let node = nodes[index]
    if node.kind == 2 { return node.scalar }
    if node.kind == 4 {
        if fixed_syntax_width(nodes, node.children[0]) == 0 {
            return first_required_literal(nodes, node.children[1])
        }
        return first_required_literal(nodes, node.children[0])
    }
    if node.kind == 5 {
        let left = first_required_literal(nodes, node.children[0])
        let right = first_required_literal(nodes, node.children[1])
        if first = left { if second = right { if first == second { return first } } }
        return null
    }
    if node.kind == 9 { return first_required_literal(nodes, node.children[0]) }
    if node.kind == 10 && node.minimum > 0 {
        return first_required_literal(nodes, node.children[0])
    }
    return null
}

func joined(left:Patch[], right:Patch[]) Patch[] {
    var result:Patch[] = []
    for value in left { result.append(value) }
    for value in right { result.append(value) }
    return result
}
