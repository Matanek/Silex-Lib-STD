use STD.Network
use STD.Network.TCP
use STD.Network.UDP
use STD.Error
use STD.Text.UTF8

test "TCP and UDP loopback" {
    func run() Result<void, Error> {
        let address = try Network.parse_ip("127.0.0.1") else error { return Result<void,Error>.failure(error) }
        let ephemeral = Network.Endpoint(address:address, port:0, scope_id:0)

        var listener = try TCP.listen(ephemeral, 8) else error { return Result<void,Error>.failure(error) }
        let listening = try TCP.local_endpoint(listener) else error { return Result<void,Error>.failure(error) }
        var client = try TCP.connect(listening, TCP.ConnectOptions(
            connect_timeout_milliseconds:null,
            stream:TCP.StreamOptions(read_timeout_milliseconds:null, write_timeout_milliseconds:null)
        )) else error { return Result<void,Error>.failure(error) }
        var accepted = try TCP.accept(
            listener,
            null,
            TCP.StreamOptions(read_timeout_milliseconds:null, write_timeout_milliseconds:null)
        ) else error { return Result<void,Error>.failure(error) }
        let payload = UTF8.bytes("tcp")
        let payload_view = @payload[0:payload.count()]
        let written = try client.write(payload_view) else error { return Result<void,Error>.failure(error) }
        assert(written == 3, "TCP write count")
        var tcp_buffer:uint8[3]
        var tcp_view = &tcp_buffer[0:3]
        let read = try accepted.stream.read(tcp_view) else error { return Result<void,Error>.failure(error) }
        assert(read == 3 && tcp_view[0] == 116 && tcp_view[2] == 112, "TCP loopback payload")
        match (try accepted.stream.shutdown_read()) {
            success => {}
            failure(error) => { panic("accepted shutdown_read: " + error.detail) }
        }
        match (try client.shutdown_write()) {
            success => {}
            failure(error) => { panic("client shutdown_write: " + error.detail) }
        }
        try TCP.close(client) else error { return Result<void,Error>.failure(error) }
        try TCP.close(accepted.stream) else error { return Result<void,Error>.failure(error) }
        try TCP.close(listener) else error { return Result<void,Error>.failure(error) }

        var receiver = try UDP.bind(ephemeral, UDP.Options(read_timeout_milliseconds:null, write_timeout_milliseconds:null)) else error { return Result<void,Error>.failure(error) }
        let destination = try UDP.local_endpoint(receiver) else error { return Result<void,Error>.failure(error) }
        var sender = try UDP.open(Network.Family.ipv4(), UDP.Options(read_timeout_milliseconds:null, write_timeout_milliseconds:null)) else error { return Result<void,Error>.failure(error) }
        let datagram = UTF8.bytes("udp")
        let datagram_view = @datagram[0:datagram.count()]
        try UDP.send_to(sender, datagram_view, destination) else error { return Result<void,Error>.failure(error) }
        var udp_buffer:uint8[8]
        var udp_view = &udp_buffer[0:8]
        let received = try UDP.receive_from(receiver, udp_view) else error { return Result<void,Error>.failure(error) }
        assert(received.count == 3 && !received.truncated, "UDP receive metadata")
        assert(udp_view[0] == 117 && udp_view[2] == 112, "UDP loopback payload")
        try UDP.close(sender) else error { return Result<void,Error>.failure(error) }
        try UDP.close(receiver) else error { return Result<void,Error>.failure(error) }
        return Result<void, Error>.success()
    }

    match (try run()) {
        success => {}
        failure(error) => { panic(error.operation + ": " + error.detail) }
    }
}
