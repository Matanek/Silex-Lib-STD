use STD.Console
use STD.Console.Session
use STD.Console.Session.KeyEvent

func describe(event:KeyEvent) str {
    return match event.key {
        character(value) => "character $(value)"
        enter => "enter"
        escape => "escape"
        tab => "tab"
        backspace => "backspace"
        delete => "delete"
        arrow_up => "arrow up"
        arrow_down => "arrow down"
        arrow_left => "arrow left"
        arrow_right => "arrow right"
        home => "home"
        end => "end"
        page_up => "page up"
        page_down => "page down"
        function(number) => "function F$(number)"
        unknown(sequence) => "unknown $(sequence)"
    }
}

func main() {
    var session = Session()
    if !session.is_open() { panic("Terminal session did not open") }
    session.enter_alternate_screen()
    Console.hide_cursor()
    Console.clear_screen()
    Console.move_cursor(0, 0)
    Console.write_line("Press Escape to leave")

    var running = true
    while running {
        let event = session.read_key()
        Console.clear_line()
        Console.write_line(describe(event))
        match event.key { escape => { running = false }; else => {} }
    }

    session.leave_alternate_screen()
    Console.show_cursor()
    session.close()
}
