use Interop.C
use Interop.Linux

let system_spawn = C.function<func(uint, uint) uint>(library:Linux.kernel, name:"thread_spawn")
let system_join = C.function<func(uint) int32>(library:Linux.kernel, name:"thread_join")

internal func spawn(entry:uint, context:uint) uint { return system_spawn(entry, context) }
internal func join(thread:uint) bool { return system_join(thread) != 0 }
internal func current_thread() uint { return 0 }

internal func create_signal(initial:int) uint {
    panic("STD.Threading.Executor is not implemented natively on linux-x64 yet")
}

internal func wait(signal:uint) { panic("STD.Threading.Executor is not implemented natively on linux-x64 yet") }
internal func try_wait(signal:uint) bool { panic("STD.Threading.Executor is not implemented natively on linux-x64 yet") }
internal func signal(value:uint) { panic("STD.Threading.Executor is not implemented natively on linux-x64 yet") }
internal func release_signal(value:uint) {}
internal func class_root_count(object:uint) int { return C.load<uint>(C.pointer_bits(object), 8 as uint) as int }
internal func revive_class(object:uint) { C.store<uint>(C.pointer_bits(object), 16 as uint, 0) }
internal func logical_processor_count() int { return 1 }
