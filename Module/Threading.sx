use Interop.C

public protocol Task { func execute() }

public static class TaskManager {
    public static func submit<T:Task>(task:T) TaskHandle<T> {
        var handle = TaskHandle<T>(task)
        handle.start()
        return handle
    }
    public static func submit<T:Task>(task:T, callback:func(T)) TaskWaitHandle<T> {
        var handle = TaskWaitHandle<T>(task, callback)
        handle.start()
        return handle
    }
}

internal class TaskState<T:Task> {
    internal var task:T
    internal var thread:uint = 0
    internal init(task:T) {
        self.task = task
    }
}

public struct TaskHandle<T:Task> {
    internal var state:TaskState<T>? = null
    public init(task:T) { self.state = TaskState<T>(task) }
    internal func shared() TaskState<T> {
        if var state = self.state { return state }
        panic("task handle has no state")
    }
    internal func start() {
        var state = self.shared()
        let value = Platform.spawn(C.function_address<T>(run_task), C.object_address(state))
        if value != 0 { state.thread = value; return }
        panic("system thread creation failed")
    }
    public func complete() T {
        var state = self.shared()
        if state.thread != 0 {
            if !Platform.join(state.thread) { panic("system thread join failed") }
            state.thread = 0
        }
        return state.task
    }
    public func complete(callback:func(T)) {
        var state = self.shared()
        if state.thread != 0 {
            if !Platform.join(state.thread) { panic("system thread join failed") }
            state.thread = 0
        }
        callback(state.task)
    }
    drop {
        var state = self.shared()
        if state.thread != 0 {
            if !Platform.join(state.thread) { panic("system thread join failed") }
            state.thread = 0
        }
    }
}

internal class TaskWaitState<T:Task> {
    internal var task:T
    internal let callback:func(T)
    internal var thread:uint = 0
    internal init(task:T, callback:func(T)) {
        self.task = task
        self.callback = callback
    }
}

public struct TaskWaitHandle<T:Task> {
    internal var state:TaskWaitState<T>? = null
    public init(task:T, callback:func(T)) { self.state = TaskWaitState<T>(task, callback) }
    internal func shared() TaskWaitState<T> {
        if var state = self.state { return state }
        panic("task handle has no state")
    }
    internal func start() {
        var state = self.shared()
        let value = Platform.spawn(C.function_address<T>(run_wait_task), C.object_address(state))
        if value != 0 { state.thread = value; return }
        panic("system thread creation failed")
    }
    public func complete() {
        var state = self.shared()
        if state.thread != 0 {
            if !Platform.join(state.thread) { panic("system thread join failed") }
            state.thread = 0
        }
    }
    drop {
        var state = self.shared()
        if state.thread != 0 {
            if !Platform.join(state.thread) { panic("system thread join failed") }
            state.thread = 0
        }
    }
}

func run_task<T:Task>(context:uint) uint {
    var state = C.object_from_address<TaskState<T>>(context)
    var running = state.task
    running.execute()
    state.task = running
    return 0
}

func run_wait_task<T:Task>(context:uint) uint {
    var state = C.object_from_address<TaskWaitState<T>>(context)
    var running = state.task
    running.execute()
    state.task = running
    invoke_callback<T>(state.callback, running)
    return 0
}

func invoke_callback<T>(callback:func(T), value:T) { callback(value) }
