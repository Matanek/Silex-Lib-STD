use STD.Iterator

public struct Queue<T> {
    private var front:T[]
    private var back:T[]
    private var reserved_capacity:int

    init() {
        self.front = []
        self.back = []
        self.reserved_capacity = 0
    }

    init(minimum_capacity:int) {
        if minimum_capacity < 0 {
            panic("Queue requires a non-negative minimum capacity")
        }
        self.front = []
        self.back = []
        self.reserved_capacity = minimum_capacity
    }

    func count() int {
        return self.front.count() + self.back.count()
    }

    func capacity() int {
        let count = self.count()
        if self.reserved_capacity < count {
            return count
        }
        return self.reserved_capacity
    }

    func is_empty() bool {
        return self.front.is_empty() && self.back.is_empty()
    }

    func contains(value:@T) bool {
        var index = self.front.count() - 1
        while index >= 0 {
            if self.front[index] == value {
                return true
            }
            index--
        }
        index = 0
        while index < self.back.count() {
            if self.back[index] == value {
                return true
            }
            index++
        }
        return false
    }

    func add(value:T) {
        if self.is_empty() {
            self.front.append(value)
        } else {
            self.back.append(value)
        }
        let count = self.count()
        if count > self.reserved_capacity {
            var capacity = self.reserved_capacity
            if capacity < 4 {
                capacity = 4
            }
            while capacity < count {
                capacity *= 2
            }
            self.reserved_capacity = capacity
        }
    }

    func take() T? {
        self.prepare_front()
        if self.front.is_empty() {
            return null
        }
        var value = self.front.take_last()
        self.prepare_front()
        return value
    }

    func peek() & T {
        if self.front.is_empty() {
            panic("Queue.peek requires a value")
        }
        return &self.front[-1]
    }

    func remove(value:@T) bool {
        var index = self.front.count() - 1
        while index >= 0 {
            if self.front[index] == value {
                self.front.take(index)
                self.prepare_front()
                return true
            }
            index--
        }
        index = 0
        while index < self.back.count() {
            if self.back[index] == value {
                self.back.take(index)
                return true
            }
            index++
        }
        return false
    }

    func reserve(minimum_capacity:int) {
        if minimum_capacity < 0 {
            panic("Queue.reserve requires a non-negative minimum capacity")
        }
        if minimum_capacity > self.reserved_capacity {
            self.reserved_capacity = minimum_capacity
        }
    }

    func clear() {
        while !self.is_empty() {
            self.take()
        }
    }

    func iterator() Iterator<T> {
        var result = Iterator<T>.empty()
        var index = self.front.count() - 1
        while index >= 0 {
            result.push(self.front[index])
            index--
        }
        index = 0
        while index < self.back.count() {
            result.push(self.back[index])
            index++
        }
        return result
    }

    private func prepare_front() {
        if !self.front.is_empty() {
            return
        }
        while !self.back.is_empty() {
            self.front.append(self.back.take_last())
        }
    }
}
