public struct LocalTime {
    let hour:int
    let minute:int
    let second:int
    let nanosecond:int

    public static func now() LocalTime {
        let components = Platform.local_time_components()
        return LocalTime(
            hour:components[0],
            minute:components[1],
            second:components[2],
            nanosecond:components[3]
        )
    }
}

internal func monotonic_microseconds() int {
    return Platform.monotonic_microseconds()
}

internal func seconds_between(start:int, end:int) float {
    let elapsed = end - start
    let whole_seconds = elapsed / 1_000_000
    let remaining_microseconds = elapsed % 1_000_000
    return (whole_seconds as float) + (remaining_microseconds as float) / 1_000_000.0
}
