use Interop.C
use Interop.Boundary

// __open is libSystem's fixed three-argument syscall veneer. The public C
// `open` function is variadic and therefore has a different Apple ARM64 ABI.
let system_open = C.function<func(C.Pointer<uint8>, int32, uint32) int32>(library:Boundary.System, name:"__open")
let system_close = C.function<func(int32) int32>(library:Boundary.System, name:"close")
let system_read = C.function<func(int32, C.Pointer<uint8>, C.Size) C.SignedSize>(library:Boundary.System, name:"read")
let system_write = C.function<func(int32, C.Pointer<uint8>, C.Size) C.SignedSize>(library:Boundary.System, name:"write")
let system_fsync = C.function<func(int32) int32>(library:Boundary.System, name:"fsync")
let system_lseek = C.function<func(int32, int, int32) int>(library:Boundary.System, name:"lseek")
let system_ftruncate = C.function<func(int32, int) int32>(library:Boundary.System, name:"ftruncate")

func open(path:str, access:int, creation:int, append:bool) int {
    var flags = access - 1
    if creation == 2 { flags += 0xA00 }
    if creation == 3 { flags += 0x200 }
    if creation == 4 { flags += 0x400 }
    if creation == 5 { flags += 0x600 }
    if append { flags += 8 }
    return system_open(C.terminated_pointer(path), flags as int32, 438) as int
}
func close(descriptor:int) bool { return system_close(descriptor as int32) == 0 }
// A bounded packed native block, independent of Silex collection layout.
func read_block(descriptor:int, buffer:&uint8[..]) int {
    var storage:uint[512]
    let address = C.address_bits(C.mutable_pointer(storage))
    let count = system_read(descriptor as int32, C.pointer_bits(address), buffer.count() as C.Size)
    if count <= 0 { return count as int }
    var index = 0
    while index < count {
        buffer[index] = C.load<uint8>(address, index as uint)
        index++
    }
    return count as int
}
func write_block(descriptor:int, buffer:@uint8[..]) int {
    var storage:uint[512]
    let address = C.address_bits(C.mutable_pointer(storage))
    var index = 0
    while index < buffer.count() {
        let stored = C.store<uint8>(address, index as uint, buffer[index])
        index++
    }
    return system_write(descriptor as int32, C.pointer_bits(address), buffer.count() as C.Size) as int
}
func flush(descriptor:int) bool { return system_fsync(descriptor as int32) == 0 }
func seek(descriptor:int, offset:int, from:int) int { return system_lseek(descriptor as int32, offset, from as int32) }
func set_length(descriptor:int, length:int) bool { return system_ftruncate(descriptor as int32, length) == 0 }
