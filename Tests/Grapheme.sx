use STD.Text.Grapheme

func main() {
    check(Grapheme.count("") == 0, "empty text")
    check(Grapheme.count("e\u{301}") == 1, "combining mark")
    check(Grapheme.count("👩‍🚀") == 1, "emoji ZWJ sequence")
    check(Grapheme.count("🇫🇷🇯🇵") == 2, "regional indicators")
    check(Grapheme.count("\u{915}\u{94d}\u{937}") == 1, "Indic conjunct")
    let parts = Grapheme.split("a👩‍🚀b")
    check(parts.count() == 3 && parts[1] == "👩‍🚀", "grapheme split")
}
func check(condition:bool, detail:str) { if !condition { panic(detail) } }
