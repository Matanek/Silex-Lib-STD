use STD.Threading
use STD.Time.Stopwatch

class Samples {
    var source:int[]
    var destination:int[]

    func transform(start:int, end:int) {
        var index = start
        while index < end {
            let value = self.source[index]
            self.destination[index] = (value * 17 + 31) % 65521
            index++
        }
    }
}

struct Transform:Threading.ParallelJob {
    var samples:Samples
    func execute(start:int, end:int) { self.samples.transform(start, end) }
}

struct Warmup:Threading.Job {
    var marker:int
    func execute() {}
}

func make_samples(count:int) Samples {
    var source:int[] = []
    var destination:int[] = []
    for index in 0...count {
        source.append(index)
        destination.append(0)
    }
    return Samples(source:source, destination:destination)
}

func performance_case(executor:Threading.Executor, count:int, rounds:int) {
    var samples = make_samples(count)

    var sequential = Stopwatch()
    sequential.start()
    for round in 0...rounds { samples.transform(0, count) }
    sequential.stop()

    var shared = executor
    shared.submit_parallel(count, Transform(samples:samples)).complete()
    let warmed_allocations = shared.parallel_allocation_count()
    let before_work = shared.parallel_work_count()

    var parallel = Stopwatch()
    parallel.start()
    for round in 0...rounds {
        shared.submit_parallel(count, Transform(samples:samples)).complete()
    }
    parallel.stop()

    let submitted_work = shared.parallel_work_count() - before_work
    let maximum_useful_work = rounds * shared.worker_count() * 4
    if shared.parallel_allocation_count() != warmed_allocations {
        panic("parallel performance test allocated batch state after warmup")
    }
    if submitted_work > maximum_useful_work {
        panic("parallel performance test submitted excessive work ranges")
    }
    var checksum = 0
    var index = 0
    while index < count {
        if samples.destination[index] != (samples.source[index] * 17 + 31) % 65521 {
            panic("parallel performance test changed its deterministic result")
        }
        checksum += samples.destination[index]
        index++
    }

    print(
        "SILEX_THREADING_PERFORMANCE_TEST mode=test workers=$(executor.worker_count()) " +
        "count=$(count) rounds=$(rounds) " +
        "sequential_ms=$(sequential.get_elapsed_milliseconds()) " +
        "parallel_ms=$(parallel.get_elapsed_milliseconds()) " +
        "ranges=$(submitted_work) allocations=$(warmed_allocations) " +
        "checksum=$(checksum)"
    )
}

func test_worker_count(worker_count:int) {
    var executor = Threading.Executor(worker_count:worker_count)
    executor.submit(Warmup(marker:0)).complete()
    performance_case(executor, 1_024, 256)
    performance_case(executor, 4_096, 64)
    performance_case(executor, 16_384, 16)
    performance_case(executor, 262_144, 16)
}

test "parallel batches stay bounded and deterministic across worker counts" {
    test_worker_count(1)
    test_worker_count(2)
    test_worker_count(4)
}
