internal protocol CompletionState {
    func is_completed() bool
    func wait_for_completion()
    func notify_waiter()
}

internal protocol DependencyTarget {
    func dependency_completed()
}

internal protocol FenceOwner {
    func graph_address_value() uint
    func set_graph_address(value:uint)
    func graph_is_completed() bool
}

internal protocol PoolResource {
    func slot_count() int
}
