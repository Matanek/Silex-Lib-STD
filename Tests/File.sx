use STD.File
use STD.FileSystem
use STD.Error

test "text and binary file IO" {
    func is_invalid_data(kind:Error.Kind) bool {
        return match kind { invalid_data => true; else => false }
    }

    let path = "/private/tmp/silex-std-file-test.txt"
    match File.write_all(path, "Silex file IO\n") {
        failure(error) => { panic(error.detail) }
        success => {}
    }
    match File.read_text(path, 1024) {
        failure(error) => { panic(error.detail) }
        success(content) => { assert(content == "Silex file IO\n", "text file round trip") }
    }

    let binary:uint8[3] = [0, 255, 10]
    match File.write_all(path, @binary[0:3]) {
        failure(error) => { panic(error.detail) }
        success => {}
    }
    match File.read_all(path, 3) {
        failure(error) => { panic(error.detail) }
        success(bytes) => {
            assert(bytes.count() == 3, "binary file size")
            assert(bytes[0] == 0 && bytes[1] == 255 && bytes[2] == 10, "binary file contents")
        }
    }
    match File.read_text(path, 3) {
        failure(error) => { assert(is_invalid_data(error.kind), "invalid UTF-8 file error") }
        success(content) => { panic("invalid UTF-8 file was accepted as text") }
    }
}

test "open creation and append modes" {
    func run() Result<void, Error> {
        let path = "/private/tmp/silex-std-file-open-modes.txt"
        let ignored = FileSystem.remove_file(path)

        var created = try File.open(path, File.OpenOptions(
            access:File.Access.read_write(),
            creation:File.Creation.create_new(),
            append:false
        ))
        let first:uint8[1] = [65]
        let first_count = try created.write(@first[0:1])
        assert(first_count == 1, "create-new write")
        try File.close(move created)

        var existing = try File.open(path, File.OpenOptions(
            access:File.Access.read_write(),
            creation:File.Creation.open_or_create(),
            append:true
        ))
        let second:uint8[1] = [66]
        let second_count = try existing.write(@second[0:1])
        assert(second_count == 1, "append write")
        try File.close(move existing)
        assert((try File.read_text(path, 2)) == "AB", "appended contents")

        var truncated = try File.open(path, File.OpenOptions(
            access:File.Access.write(),
            creation:File.Creation.truncate_existing(),
            append:false
        ))
        assert((try truncated.length()) == 0, "truncate-existing length")
        try File.close(move truncated)
        try FileSystem.remove_file(path)
        return Result<void, Error>.success()
    }

    match run() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}
