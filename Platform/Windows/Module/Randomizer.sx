use Interop.C
use Interop.Boundary

let process_random = C.function<
    func(C.MutablePointer<uint32>, C.Size) int32
>(
    library:Boundary.Crypto,
    name:"ProcessPrng"
)

func system_seed() int {
    var seed:uint32 = 0
    let success = process_random(C.mutable_pointer(seed), 4 as C.Size)
    if success == 0 {
        panic("Windows ProcessPrng could not produce a seed")
    }
    return seed as int
}
