use STD.Randomizer

test "deterministic seed" {
    var randomizer = Randomizer(42)
    assert(randomizer.get_int() == 45454805674)
}

test "generated values stay in their ranges" {
    var randomizer = Randomizer(42)

    let integer = randomizer.get_int(-10, 10)
    assert(integer >= -10 && integer < 10)

    let fractional = randomizer.get_float()
    assert(fractional >= 0.0 && fractional < 1.0)
}

test "system seed" {
    var randomizer = Randomizer()
    assert(randomizer.get_int() > 0)
}
