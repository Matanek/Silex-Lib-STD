use STD.Collections.Dictionary
use STD.Collections.Hashing
use STD.Collections.Queue
use STD.Collections.Set
use STD.Collections.Stack

class Token {
    let name:str
}

test "portable hashing" {
    assert(Hashing.hash("hello") == 11831194018420276491, "portable string hash")
    assert(Hashing.hash_bool(true) == 1, "boolean hash")
    assert(Hashing.hash_int(-7) == 13, "integer hash")
    assert(Hashing.hash_uint(7 as uint) == 7, "unsigned integer hash")
    assert(Hashing.hash_str("hello") == Hashing.hash("hello"), "string hash helper")
    assert(Hashing.equal_bool(true, true), "boolean equality")
    assert(Hashing.equal_int(-7, -7), "integer equality")
    assert(Hashing.equal_uint(7 as uint, 7 as uint), "unsigned integer equality")
    assert(Hashing.equal_str("Silex", "Silex"), "string equality")
    assert(Hashing.equal("Silex", "Silex"), "overloaded equality")
}

test "dictionary operations" {
    func absolute_hash(value:@int) uint {
        if value < 0 { return (-value) as uint }
        return value as uint
    }

    func same_key(left:@int, right:@int) bool {
        return absolute_hash(left) == absolute_hash(right)
    }

    var dictionary = Dictionary<int, str>(absolute_hash, same_key)
    assert(dictionary.set(-7, "seven") == null, "new dictionary entry")
    assert(dictionary.contains(7), "custom hash and equality callbacks")
    assert(dictionary.get(-7) == "seven", "borrowed dictionary value")
    if previous = dictionary.set(7, "updated") {
        assert(previous == "seven", "replaced dictionary value")
    } else {
        assert(false, "previous dictionary value")
    }
    if key = dictionary.find_key("updated") {
        assert(key == -7, "dictionary key found from value")
    } else {
        assert(false, "dictionary reverse lookup")
    }
    assert(dictionary.find_key("missing") == null, "missing dictionary value")
    assert(dictionary.remove(-7), "removed dictionary association")
    assert(!dictionary.remove(7), "missing dictionary association")
    assert(!dictionary.contains(7), "dictionary key removed")

    let reserved = Dictionary<int, str>(minimum_capacity:16)
    assert(reserved.capacity() >= 16, "named dictionary minimum capacity")
}

test "dictionary traversal" {
    var dictionary = Dictionary<str, int>()
    dictionary.set("Ada", 12)
    dictionary.set("Linus", 9)
    dictionary.set("Grace", 15)

    var entries = dictionary.iterator()
    var entry_count = 0
    var total = 0
    while entry = entries.next() {
        assert(dictionary.get(entry.key) == entry.value, "entry preserves its association")
        entry_count++
        total += entry.value
    }
    assert(entry_count == 3, "iterator visits every dictionary entry")
    assert(total == 36, "iterator visits every dictionary value")
    assert(entries.is_empty(), "dictionary iterator is exhausted")

    var keys = dictionary.get_keys()
    var values = dictionary.get_values()
    assert(keys.count() == dictionary.count(), "key snapshot contains every key")
    assert(values.count() == dictionary.count(), "value snapshot contains every value")
    keys.clear()
    values.clear()
    assert(dictionary.count() == 3, "dictionary snapshots are independent copies")
}

test "set operations" {
    var values = Set<int>()
    assert(values.add(42), "new set value")
    assert(!values.add(42), "duplicate set value")
    assert(values.contains(42), "default hashing callbacks")
    assert(values.remove(42), "removed set value")
    assert(!values.contains(42), "set value removed")

    let reserved = Set<int>(minimum_capacity:16)
    assert(reserved.capacity() >= 16, "named set minimum capacity")

    values.add(4)
    values.add(8)
    var iterator = values.iterator()
    var total = 0
    while value = iterator.next() { total += value }
    assert(total == 12, "set iterator visits every value")
}

test "queue operations" {
    var queue = Queue<int>()
    queue.add(1)
    queue.add(2)
    queue.add(3)
    queue.add(2)
    assert(queue.contains(2), "queue contains value")
    assert(!queue.contains(4), "queue missing value")
    assert(queue.remove(2), "queue removes oldest matching value")
    assert(queue.peek() == 1, "borrowed queue front")
    if first = queue.take() {
        assert(first == 1, "queue order")
    } else {
        assert(false, "queue value")
    }
    if second = queue.take() {
        assert(second == 3, "queue order after removal")
    } else {
        assert(false, "queue value after removal")
    }
    assert(queue.remove(2), "queue removes remaining value")
    assert(!queue.remove(2), "queue removal reports absence")

    queue.add(4)
    queue.add(5)
    var iterator = queue.iterator()
    if first = iterator.next() {
        assert(first == 4, "queue iterator starts at the front")
    } else {
        assert(false, "queue iterator first value")
    }
    if second = iterator.next() {
        assert(second == 5, "queue iterator follows insertion order")
    } else {
        assert(false, "queue iterator second value")
    }
    assert(iterator.next() == null, "queue iterator is exhausted")
    assert(queue.count() == 2, "queue iteration does not consume the queue")
}

test "stack operations" {
    var stack = Stack<int>()
    stack.add(1)
    stack.add(2)
    stack.add(3)
    stack.add(2)
    assert(stack.contains(2), "stack contains value")
    assert(!stack.contains(4), "stack missing value")
    assert(stack.remove(2), "stack removes newest matching value")
    assert(stack.peek() == 3, "borrowed stack top after removal")
    if top = stack.take() {
        assert(top == 3, "stack order after removal")
    } else {
        assert(false, "stack value")
    }
    assert(stack.remove(2), "stack removes remaining value")
    assert(!stack.remove(2), "stack removal reports absence")

    stack.add(4)
    stack.add(5)
    var iterator = stack.iterator()
    if first = iterator.next() {
        assert(first == 5, "stack iterator starts at the top")
    } else {
        assert(false, "stack iterator first value")
    }
    if second = iterator.next() {
        assert(second == 4, "stack iterator follows removal order")
    } else {
        assert(false, "stack iterator second value")
    }
    if third = iterator.next() {
        assert(third == 1, "stack iterator reaches the bottom")
    } else {
        assert(false, "stack iterator third value")
    }
    assert(iterator.next() == null, "stack iterator is exhausted")
    assert(stack.count() == 3, "stack iteration does not consume the stack")
}

test "class identity in collections" {
    var token = Token(name:"same")
    var alias = token
    var distinct = Token(name:"same")

    var indexed = Dictionary<int, Token>()
    indexed.set(11, token)
    if token_key = indexed.find_key(alias) {
        assert(token_key == 11, "dictionary finds a shared class identity")
    } else {
        assert(false, "dictionary class identity")
    }
    assert(indexed.find_key(distinct) == null, "dictionary rejects a distinct class identity")

    var token_queue = Queue<Token>()
    token_queue.add(token)
    assert(token_queue.contains(alias), "queue contains a shared class identity")
    assert(!token_queue.contains(distinct), "queue rejects a distinct class identity")
    assert(token_queue.remove(alias), "queue removes a shared class identity")

    var token_stack = Stack<Token>()
    token_stack.add(token)
    assert(token_stack.contains(alias), "stack contains a shared class identity")
    assert(!token_stack.contains(distinct), "stack rejects a distinct class identity")
    assert(token_stack.remove(alias), "stack removes a shared class identity")
}

test "collection reservation and clearing" {
    var dictionary = Dictionary<int, str>()
    dictionary.reserve(12)
    assert(dictionary.capacity() >= 12, "dictionary reserve")
    dictionary.set(1, "one")
    dictionary.clear()
    assert(dictionary.is_empty(), "dictionary clear")

    var set = Set<int>()
    set.reserve(12)
    assert(set.capacity() >= 12, "set reserve")
    set.add(1)
    set.clear()
    assert(set.is_empty(), "set clear")

    var queue = Queue<int>()
    queue.reserve(12)
    assert(queue.capacity() >= 12, "queue reserve")
    queue.add(1)
    queue.clear()
    assert(queue.is_empty(), "queue clear")

    var stack = Stack<int>()
    stack.reserve(12)
    assert(stack.capacity() >= 12, "stack reserve")
    stack.add(1)
    stack.clear()
    assert(stack.is_empty(), "stack clear")
}
