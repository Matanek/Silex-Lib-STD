{
  "name": "STD",
  "version": "0.21.0",
  "description": {
    "en": "The standard library for portable Silex applications.",
    "fr": "La bibliothèque standard des applications Silex portables."
  },
  "authors": ["Matanek"],
  "requires": {
    "silex": ">=0.43.0"
  },
  "boundary": {
    "macos-arm64": {
      "providers": {
        "System": {
          "libraries": ["System"]
        },
        "Security": {
          "frameworks": ["CoreFoundation", "Security"]
        },
        "FileWatch": {
          "frameworks": ["CoreFoundation", "CoreServices"]
        },
        "TerminalSession": {
          "archive": "Boundary/macos-arm64/libTerminalSession.a",
          "libraries": ["System"]
        },
        "Compression": {
          "archive": "Boundary/macos-arm64/libCompression.a"
        },
        "CryptoPrimitives": {
          "archive": "Boundary/macos-arm64/libCryptoPrimitives.a"
        },
        "NetworkRuntime": {
          "archive": "Boundary/macos-arm64/libNetworkRuntime.a"
        }
      }
    },
    "linux-x64": {
      "providers": {
        "System": {
          "libraries": ["c", "m", "pthread"]
        },
        "TerminalSession": {
          "archive": "Boundary/linux-x64/libTerminalSession.a",
          "libraries": ["c"]
        },
        "Compression": {
          "archive": "Boundary/linux-x64/libCompression.a"
        },
        "CryptoPrimitives": {
          "archive": "Boundary/linux-x64/libCryptoPrimitives.a"
        },
        "NetworkRuntime": {
          "archive": "Boundary/linux-x64/libNetworkRuntime.a"
        }
      }
    },
    "windows-x64": {
      "providers": {
        "System": {
          "libraries": ["kernel32"]
        },
        "Shell": {
          "libraries": ["shell32"]
        },
        "Runtime": {
          "libraries": ["ucrtbase"]
        },
        "Crypto": {
          "libraries": ["bcryptprimitives"]
        },
        "Network": {
          "libraries": ["ws2_32"]
        },
        "TerminalSession": {
          "archive": "Boundary/windows-x64/TerminalSession.lib",
          "libraries": ["kernel32"]
        },
        "Compression": {
          "archive": "Boundary/windows-x64/Compression.lib"
        },
        "CryptoPrimitives": {
          "archive": "Boundary/windows-x64/CryptoPrimitives.lib"
        },
        "NetworkRuntime": {
          "archive": "Boundary/windows-x64/NetworkRuntime.lib"
        }
      }
    },
    "windows-arm64": {
      "providers": {
        "System": {
          "libraries": ["kernel32"]
        },
        "Shell": {
          "libraries": ["shell32"]
        },
        "Runtime": {
          "libraries": ["ucrtbase"]
        },
        "Crypto": {
          "libraries": ["bcryptprimitives"]
        },
        "Network": {
          "libraries": ["ws2_32"]
        },
        "TerminalSession": {
          "archive": "Boundary/windows-arm64/TerminalSession.lib",
          "libraries": ["kernel32"]
        },
        "Compression": {
          "archive": "Boundary/windows-arm64/Compression.lib"
        },
        "CryptoPrimitives": {
          "archive": "Boundary/windows-arm64/CryptoPrimitives.lib"
        },
        "NetworkRuntime": {
          "archive": "Boundary/windows-arm64/NetworkRuntime.lib"
        }
      }
    }
  }
}
