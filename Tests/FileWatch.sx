use STD.Error
use STD.File
use STD.FileSystem
use STD.FileWatch

test "observe recursive workspace changes" {
    func run() Result<void, Error> {
        let root = "/private/tmp/silex-std-file-watch-test"
        let nested = root + "/sources"
        let source = nested + "/Main.sx"
        let ignored_source = FileSystem.remove_file(source)
        let ignored_nested = FileSystem.remove_directory(nested)
        let ignored_root = FileSystem.remove_directory(root)
        try FileSystem.create_directories(nested)

        var watcher = try FileWatch.open(root, FileWatch.Options(recursive:true))
        try File.write_all(source, "func main() {}")
        var observed = false
        var attempts = 0
        while !observed && attempts < 30 {
            let next = try watcher.next(100)
            if event = next {
                match event {
                    rescan_required => { observed = true }
                    change(kind, path) => {
                        if path == source {
                            match kind {
                                created => { observed = true }
                                modified => { observed = true }
                                else => {}
                            }
                        }
                    }
                }
            }
            attempts++
        }
        watcher.close()
        try FileSystem.remove_file(source)
        try FileSystem.remove_directory(nested)
        try FileSystem.remove_directory(root)
        assert(observed, "recursive file watch event")
        return Result<void, Error>.success()
    }

    match run() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}

test "limit non-recursive watches to direct children" {
    func run() Result<void, Error> {
        let root = "/private/tmp/silex-std-file-watch-shallow-test"
        let nested = root + "/nested"
        let nested_file = nested + "/ignored.txt"
        let direct_file = root + "/observed.txt"
        let ignored_nested_file = FileSystem.remove_file(nested_file)
        let ignored_direct_file = FileSystem.remove_file(direct_file)
        let ignored_nested = FileSystem.remove_directory(nested)
        let ignored_root = FileSystem.remove_directory(root)
        try FileSystem.create_directories(nested)

        var watcher = try FileWatch.open(root, FileWatch.Options(recursive:false))
        try File.write_all(nested_file, "nested")
        try File.write_all(direct_file, "direct")
        var observed_direct = false
        var observed_nested = false
        var attempts = 0
        while !observed_direct && attempts < 30 {
            let next = try watcher.next(100)
            if event = next {
                match event {
                    rescan_required => { observed_direct = true }
                    change(kind, path) => {
                        if path == nested_file { observed_nested = true }
                        if path == direct_file { observed_direct = true }
                    }
                }
            }
            attempts++
        }
        watcher.close()
        try FileSystem.remove_file(nested_file)
        try FileSystem.remove_file(direct_file)
        try FileSystem.remove_directory(nested)
        try FileSystem.remove_directory(root)
        assert(!observed_nested, "non-recursive watch excludes descendants")
        assert(observed_direct, "non-recursive watch includes direct children")
        return Result<void, Error>.success()
    }

    match run() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}

test "validate watcher timeout and closed state" {
    func run() Result<void, Error> {
        let root = "/private/tmp/silex-std-file-watch-state-test"
        let ignored_root = FileSystem.remove_directory(root)
        try FileSystem.create_directory(root)
        var watcher = try FileWatch.open(root, FileWatch.Options(recursive:false))
        match watcher.next(-1) {
            success(event) => { panic("negative timeout was accepted") }
            failure(error) => { assert(error.operation == "file_watch.next", "negative timeout operation") }
        }
        watcher.close()
        watcher.close()
        match watcher.next(0) {
            success(event) => { panic("closed watcher was polled") }
            failure(error) => { assert(error.operation == "file_watch.next", "closed watcher operation") }
        }
        try FileSystem.remove_directory(root)
        return Result<void, Error>.success()
    }

    match run() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}
