use Interop.C
use Interop.Linux

let getrandom = C.function<
    func(C.MutablePointer<uint32>, C.Size, uint32) C.SignedSize
>(
    library:Linux.kernel,
    name:"getrandom"
)

func random_word() uint32 {
    var value:uint32 = 0
    let written = getrandom(C.mutable_pointer(value), 4 as C.Size, 0)
    if written != 4 as C.SignedSize {
        panic("Linux getrandom could not produce complete crypto entropy")
    }
    return value
}
