use STD.Error
use STD.File
use STD.FileSystem

func publish() Result<void, Error> {
    let root = "silex-publish-example"
    let staging = root + "/staging"
    let releases = root + "/releases/2026"
    try FileSystem.create_directory(root)
    try FileSystem.create_directory(staging)
    try FileSystem.create_directories(releases)

    let draft = staging + "/report.txt"
    let copied = releases + "/report.copy"
    let published = releases + "/report.txt"
    try File.write_all(draft, "release ready\n")
    try FileSystem.copy_file(draft, copied, false)
    try FileSystem.rename(copied, published)
    try FileSystem.set_readonly(published, true)

    for entry in try FileSystem.list(releases) {
        print("Published: $(entry.name)")
    }

    try FileSystem.set_readonly(published, false)
    try FileSystem.remove_file(draft)
    try FileSystem.remove_file(published)
    try FileSystem.remove_directory(staging)
    try FileSystem.remove_directory(releases)
    try FileSystem.remove_directory(root + "/releases")
    try FileSystem.remove_directory(root)
    return Result<void, Error>.success()
}

func main() {
    match publish() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}
