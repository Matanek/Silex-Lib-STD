use STD.Math

public struct Vec2 {

    var x:float
    var y:float

    init() {}

    init(value:float) {
        self.x = value
        self.y = value
    }

    init(x:float, y:float) {
        self.x = x
        self.y = y
    }

    func add(other:Vec2) Vec2 {
        return Vec2(self.x + other.x, self.y + other.y)
    }

    func subtract(other:Vec2) Vec2 {
        return Vec2(self.x - other.x, self.y - other.y)
    }

    func multiply(value:Vec2) Vec2 {
        return Vec2(self.x * value.x, self.y * value.y)
    }

    func multiply(value:float) Vec2 {
        return Vec2(self.x * value, self.y * value)
    }

    func divide(value:Vec2) Vec2 {
        return Vec2(self.x / value.x, self.y / value.y)
    }

    func divide(value:float) Vec2 {
        return Vec2(self.x / value, self.y / value)
    }

    func negated() Vec2 {
        return Vec2(-self.x, -self.y)
    }

    func dot(other:Vec2) float {
        return self.x * other.x + self.y * other.y
    }

    func length_squared() float {
        return self.dot(self)
    }

    func length() float {
        return Math.sqrt(self.length_squared())
    }

    func distance(other:Vec2) float {
        return self.subtract(other).length()
    }

    func normalized() Vec2 {
        let scale = Math.max(Math.abs(self.x), Math.abs(self.y))
        if scale == 0.0 && !Math.is_nan(self.x) && !Math.is_nan(self.y) { return Vec2.zero() }
        let scaled = self.divide(scale)
        return scaled.divide(Math.sqrt(scaled.length_squared()))
    }

    func lerp(other:Vec2, amount:float) Vec2 {
        return Vec2(
            Math.lerp(self.x, other.x, amount),
            Math.lerp(self.y, other.y, amount)
        )
    }

    func mix(other:Vec2, amount:float) Vec2 {
        return self.lerp(other, amount)
    }

    func minimum(other:Vec2) Vec2 {
        return Vec2(Math.min(self.x, other.x), Math.min(self.y, other.y))
    }

    func maximum(other:Vec2) Vec2 {
        return Vec2(Math.max(self.x, other.x), Math.max(self.y, other.y))
    }

    func clamped(minimum:Vec2, maximum:Vec2) Vec2 {
        return Vec2(
            Math.clamp(self.x, minimum.x, maximum.x),
            Math.clamp(self.y, minimum.y, maximum.y)
        )
    }

    func floor() Vec2 {
        return Vec2(Math.floor(self.x), Math.floor(self.y))
    }

    func ceil() Vec2 {
        return Vec2(Math.ceil(self.x), Math.ceil(self.y))
    }

    func round() Vec2 {
        return Vec2(Math.round(self.x), Math.round(self.y))
    }

    func trunc() Vec2 {
        return Vec2(Math.trunc(self.x), Math.trunc(self.y))
    }

    func nearly_equal(other:Vec2) bool {
        return Math.nearly_equal(self.x, other.x) && Math.nearly_equal(self.y, other.y)
    }

    func nearly_equal(other:Vec2, tolerance:float) bool {
        return Math.nearly_equal(
            self.x,
            other.x,
            tolerance
        ) && Math.nearly_equal(self.y, other.y, tolerance)
    }

    func to_str() str {
        return "{ $(self.x) $(self.y) }"
    }
}

extend Vec2 {
    static func zero() Vec2 { return Vec2() }
    static func one() Vec2 { return Vec2(1.0) }
    static func left() Vec2 { return Vec2(-1.0, 0.0) }
    static func right() Vec2 { return Vec2(1.0, 0.0) }
    static func up() Vec2 { return Vec2(0.0, 1.0) }
    static func down() Vec2 { return Vec2(0.0, -1.0) }
}
