use Interop.C
use Interop.MacOS

let system_create = C.function<func(C.MutablePointer<uint>, C.Pointer<uint8>, C.Pointer<uint8>, C.Pointer<uint8>) int32>(library:MacOS.lib_system, name:"pthread_create")
let system_join = C.function<func(uint, C.Pointer<uint8>) int32>(library:MacOS.lib_system, name:"pthread_join")
func spawn(entry:uint, context:uint) uint {
    var handle:uint = 0
    if system_create(C.mutable_pointer(handle), C.pointer_bits(0 as uint), C.pointer_bits(entry), C.pointer_bits(context)) != 0 { return 0 }
    return handle
}
func join(thread:uint) bool { return system_join(thread, C.pointer_bits(0 as uint)) == 0 }
