use Interop.C
use Interop.Linux
use STD.SystemTimeZone

let clock_gettime = C.function<func(int32, C.MutablePointer<int>) int32>(
    library:Linux.kernel,
    name:"clock_gettime"
)

func monotonic_microseconds() int {
    var time:int[2] = [0, 0]
    let clock_monotonic:int32 = 1
    let result = clock_gettime(clock_monotonic, C.mutable_pointer(time))
    if result != 0 { panic("Linux clock_gettime(CLOCK_MONOTONIC) failed") }
    return time[0] * 1_000_000 + time[1] / 1_000
}

func local_time_components() int[4] {
    var time:int[2] = [0, 0]
    let clock_realtime:int32 = 0
    let result = clock_gettime(clock_realtime, C.mutable_pointer(time))
    if result != 0 { panic("Linux clock_gettime(CLOCK_REALTIME) failed") }
    return SystemTimeZone.local_time_components(
        time[0],
        time[1],
        SystemTimeZone.linux_offset_at(time[0])
    )
}
