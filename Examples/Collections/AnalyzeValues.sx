use STD.Algorithms.Iteration
use STD.Iterator

func passing(score:@int) bool { return score >= 10 }
func doubled(score:@int) int { return score * 2 }

func main() {
    let scores:int[] = [12, 9, 15]
    let passing_count = Iteration.count_where<int>(Iterator.iterate<int>(scores), passing)
    print("Passing scores: $(passing_count)")

    var scaled = Iteration.map<int, int>(Iterator.iterate<int>(scores), doubled)
    while score = scaled.next() { print("Scaled: $(score)") }
}
