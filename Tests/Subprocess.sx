use STD.Console
use STD.Error
use STD.Process
use STD.Subprocess
use STD.System
use STD.Text.UTF8
use STD.Text

test "capture child input and output" {
    func validate(output:Subprocess.Output) {
        match output.status {
            exited(code) => { if code != 0 { panic("wrong exit status") } }
            signaled(signal) => { panic("unexpected signal") }
        }
        if output.standard_output.count() != 6 || output.standard_error.count() != 3 { panic("wrong captured output") }
    }

    func run_parent(executable:str) {
        let command = Subprocess.Command(
            executable:executable,
            arguments:["--subprocess-child"],
            current_directory:null,
            inherit_environment:true,
            environment:[],
            standard_input:[111 as uint8, 107 as uint8, 10 as uint8],
            maximum_output_bytes:1024
        )
        match Subprocess.run(command) {
            failure(error) => { panic(error.detail) }
            success(output) => { validate(output) }
        }
    }

    func dispatch(arguments:str[]) {
        if arguments.count() > 1 && arguments[1] == "--subprocess-child" {
            let input = Console.read_line()
            if value = input { Console.write("out:" + value) }
            Console.write_error("err")
            return
        }
        match Process.executable_path() {
            failure(error) => { panic(error.detail) }
            success(executable) => { run_parent(executable) }
        }
    }

    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(arguments) => { dispatch(arguments) }
    }
}

test "stream child input and output before exit" {
    func child() {
        if value = Console.read_line() {
            Console.write("stream:" + value)
            Console.write_error("diagnostic")
        }
    }

    func parent(executable:str) Result<void, Error> {
        let command = Subprocess.SpawnCommand(
            executable:executable,
            arguments:["--subprocess-stream-child"],
            current_directory:null,
            inherit_environment:true,
            environment:[]
        )
        var process = try Subprocess.spawn(command)
        let input = UTF8.bytes("ready\n")
        let input_view = @input[0:input.count()]
        let written = try process.write_standard_input(input_view)
        assert(written == input.count(), "interactive child input")
        try process.close_standard_input()

        var standard_output:uint8[] = []
        var standard_error:uint8[] = []
        var exited = false
        var attempts = 0
        while !exited && attempts < 20 {
            let next = try process.next_event(250)
            if event = next {
                match event {
                    output(stream, bytes) => {
                        match stream {
                            standard_output => { for byte in bytes { standard_output.append(byte) } }
                            standard_error => { for byte in bytes { standard_error.append(byte) } }
                        }
                    }
                    exited(status) => {
                        match status {
                            exited(code) => { assert(code == 0, "interactive child exit status") }
                            signaled(signal) => { panic("interactive child was signaled") }
                        }
                        exited = true
                    }
                }
            }
            attempts++
        }
        assert(exited, "interactive child completion")
        let output_view = @standard_output[0:standard_output.count()]
        let error_view = @standard_error[0:standard_error.count()]
        match UTF8.decode(output_view) {
            failure(error) => { panic("interactive standard output is invalid UTF-8") }
            success(text) => { assert(text == "stream:ready", "interactive standard output") }
        }
        match UTF8.decode(error_view) {
            failure(error) => { panic("interactive standard error is invalid UTF-8") }
            success(text) => { assert(text == "diagnostic", "interactive standard error") }
        }
        return Result<void, Error>.success()
    }

    func dispatch() Result<void, Error> {
        let arguments = try Process.arguments()
        if arguments.count() > 1 && arguments[1] == "--subprocess-stream-child" {
            child()
            return Result<void, Error>.success()
        }
        return parent(try Process.executable_path())
    }

    match dispatch() {
        failure(error) => { panic(error.operation + ": " + error.detail) }
        success => {}
    }
}

test "environment changes stay in the child" {
    func validate_environment_output(output:Subprocess.Output, expected:str) {
        match output.status {
            exited(code) => { if code != 0 { panic("environment probe failed") } }
            signaled(signal) => { panic("environment probe was signaled") }
        }
        let view = @output.standard_output[0:output.standard_output.count()]
        match UTF8.decode(view) {
            failure(error) => { panic("environment probe returned invalid UTF-8") }
            success(text) => { assert(text == expected, "subprocess environment is scoped to the child") }
        }
    }

    func expect_environment_output(command:Subprocess.Command, expected:str) {
        match Subprocess.run(command) {
            failure(error) => { panic(error.detail) }
            success(output) => { validate_environment_output(output, expected) }
        }
    }

    func run_environment_probes() {
        let assigned = Subprocess.Command(
            executable:"/usr/bin/env",
            arguments:[],
            current_directory:null,
            inherit_environment:false,
            environment:[Subprocess.EnvironmentChange.set("SILEX_SUBPROCESS_SCOPE", "child")],
            standard_input:[],
            maximum_output_bytes:1024
        )
        expect_environment_output(assigned, "SILEX_SUBPROCESS_SCOPE=child\n")

        let removed = Subprocess.Command(
            executable:"/usr/bin/env",
            arguments:[],
            current_directory:null,
            inherit_environment:false,
            environment:[
                Subprocess.EnvironmentChange.set("SILEX_SUBPROCESS_SCOPE", "child"),
                Subprocess.EnvironmentChange.remove("SILEX_SUBPROCESS_SCOPE"),
            ],
            standard_input:[],
            maximum_output_bytes:1024
        )
        expect_environment_output(removed, "")
    }

    func validate_environment_changes() {
        match System.platform() {
            windows => {}
            macos => { run_environment_probes() }
            linux => { run_environment_probes() }
        }
    }

    validate_environment_changes()
}

test "terminal child uses the portable terminal transport" {
    func child() {
        if value = Console.read_line() { Console.write("terminal:" + value) }
    }

    func parent(executable:str, arguments:str[]) Result<void, Error> {
        let command = Subprocess.TerminalCommand(
            executable:executable,
            arguments:arguments,
            current_directory:null,
            inherit_environment:true,
            environment:[],
            size:Subprocess.TerminalSize(columns:80, rows:24)
        )
        var terminal = try Subprocess.spawn_terminal(command)
        try terminal.resize(Subprocess.TerminalSize(columns:100, rows:30))
        let input = UTF8.bytes("ready\r")
        let input_view = @input[0:input.count()]
        assert(try terminal.write(input_view) == input.count(), "complete terminal input")
        var output:uint8[] = []
        var exited = false
        var attempts = 0
        while !exited && attempts < 40 {
            let next = try terminal.next_event(250)
            if event = next {
                match event {
                    output(stream, bytes) => { for byte in bytes { output.append(byte) } }
                    exited(status) => {
                        match status {
                            exited(code) => {
                                if code != 0 { print("SILEX_SUBPROCESS_TERMINAL_EXIT code=$(code)") }
                                assert(code == 0, "terminal child exit status")
                            }
                            signaled(signal) => { panic("terminal child was signaled") }
                        }
                        exited = true
                    }
                }
            }
            attempts++
        }
        assert(exited, "terminal child completion")
        let output_view = @output[0:output.count()]
        match UTF8.decode(output_view) {
            failure(error) => { panic("terminal output is invalid UTF-8") }
            success(text) => { assert(Text.contains(text, "terminal:ready"), "terminal output") }
        }
        return Result<void, Error>.success()
    }

    func dispatch() Result<void, Error> {
        let arguments = try Process.arguments()
        if arguments.count() > 1 && arguments[1] == "--subprocess-terminal-child" {
            child()
            return Result<void, Error>.success()
        }
        match System.platform() {
            windows => { return parent("cmd.exe", ["/d", "/q", "/c", "set /p value=& echo terminal:ready"]) }
            macos => { return parent(try Process.executable_path(), ["--subprocess-terminal-child"]) }
            linux => { return parent(try Process.executable_path(), ["--subprocess-terminal-child"]) }
        }
    }

    match dispatch() { failure(error) => { panic(error.operation + ": " + error.detail) }; success => {} }
}
