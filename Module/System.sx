public enum OperatingSystem {
    macos
    linux
    windows
}

public enum Architecture {
    arm64
    x64
}

public struct CompilationTarget {
    let platform:OperatingSystem
    let architecture:Architecture
}

public func platform() OperatingSystem {
    let value = Platform.value()
    if value == 1 { return OperatingSystem.macos() }
    if value == 2 { return OperatingSystem.linux() }
    if value == 3 { return OperatingSystem.windows() }
    panic("STD platform selection is invalid")
}

public func target() CompilationTarget {
    let selected_platform = platform()
    let architecture = Target.architecture()
    if architecture == 1 { return CompilationTarget(platform:selected_platform, architecture:Architecture.arm64()) }
    if architecture == 2 { return CompilationTarget(platform:selected_platform, architecture:Architecture.x64()) }
    panic("STD target selection is invalid")
}

public func platform_name(value:OperatingSystem) str {
    return match value {
        macos => "macos"
        linux => "linux"
        windows => "windows"
    }
}

public func target_name(value:CompilationTarget) str {
    return platform_name(value.platform) + "-" + match value.architecture {
        arm64 => "arm64"
        x64 => "x64"
    }
}
