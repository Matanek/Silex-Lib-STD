use STD.Text

func main() {
    check(Text.normalize("e\u{301}", Text.Normalization.nfc()) == "é", "NFC composition")
    check(Text.normalize("é", Text.Normalization.nfd()) == "e\u{301}", "NFD decomposition")
    check(Text.normalize("①", Text.Normalization.nfkc()) == "1", "NFKC compatibility")
    check(Text.uppercase("Straße") == "STRASSE", "full uppercase mapping")
    check(Text.lowercase("ΟΣ") == "ος", "final sigma")
    check(Text.case_fold("Straße") == "strasse", "full case folding")
    check(Text.unicode_version() == "17.0.0", "Unicode version")
}

func check(condition:bool, detail:str) { if !condition { panic(detail) } }
