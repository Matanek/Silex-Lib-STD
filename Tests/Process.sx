use STD.Process

func main() {
    assert(Process.id() > 0, "process id")
    match Process.arguments() {
        failure(error) => { panic(error.detail) }
        success(values) => { assert(values.count() > 0, "process arguments") }
    }
    match Process.current_directory() {
        failure(error) => { panic(error.detail) }
        success(directory) => { verify_directory(directory) }
    }
    match Process.executable_path() {
        failure(error) => { panic(error.detail) }
        success(path) => { assert(path.count() > 0, "executable path") }
    }
}

func verify_directory(directory:str) {
    assert(directory.count() > 0, "current directory")
    match Process.set_current_directory(directory) {
        failure(error) => { panic(error.detail) }
        success => {}
    }
}
